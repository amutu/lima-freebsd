version: 2
ethernets:
  {{- range $nw := .Networks}}
  {{$nw.Interface}}:
    match:
      macaddress: '{{$nw.MACAddress}}'
    set-name: {{$nw.Interface}}
    {{- if eq $.Param.internal_netplanOptional "true" }}
    optional: true
    {{- end }}
    {{- if and (eq $.VMType "bhyve") (eq $nw.Interface $.SlirpNICName) }}
    addresses:
      - '{{$.SlirpIPAddress}}/{{$.SlirpPrefixLen}}'
    {{- if eq $.OS "FreeBSD" }}
    {{- /* nuageinit only understands the netplan `gateway4` key for the IPv4 default route;
         it ignores `routes`. */}}
    gateway4: {{$.SlirpGateway}}
    {{- else }}
    routes:
      - to: default
        via: {{$.SlirpGateway}}
    {{- end }}
    {{- else }}
    dhcp4: true
    dhcp4-overrides:
      route-metric: {{$nw.Metric}}
    dhcp-identifier: mac
    {{- end }}
    {{- if and (eq $nw.Interface $.SlirpNICName) (gt (len $.DNSAddresses) 0) }}
    nameservers:
      addresses:
      {{- range $ns := $.DNSAddresses }}
      - {{$ns}}
      {{- end }}
    {{- end }}
  {{- end }}
